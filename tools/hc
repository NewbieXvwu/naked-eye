#!/usr/bin/env python3
"""hc — the agent's command line. Talks ONLY to the honest API (port 7070, or this copy's slot: tools/ports.py).

  hc obs                      what I perceive right now (+ new sounds/chat/task results)
  hc map [r]                  top-down sketch of what I remember seeing
  hc walk X Y Z [risk]        walk there with the built-in A* over remembered terrain
  hc go X Y Z                 walk there with (honest) Baritone over remembered terrain
  hc near X Y Z               walk until standing next to that block (Baritone)
  hc pause [on|off]           pause the world to think / allow or forbid automatic pausing on alarms
  hc speed [N|auto]           fast-forward everything N times (server and client together); auto = the fastest this machine keeps up
  hc pause idle on|off        freeze the world whenever nothing is running (default on: the world waits while I think)
  hc cave                     places I know nearby as a graph: walk / one-way drops / climbs, unexplored openings, marks
  hc recall BLOCK             where do I remember seeing it (lava, water, iron_ore…), nearest first
  hc sonar                    how far I can walk in each of 8 directions (and what stops me)
  hc goto P3|F1|NAME          go to a place / frontier from the last `hc cave`, or a mark
  hc mark NAME                remember where I'm standing (shows up in `hc cave`)
  hc drop ITEM,ITEM|SLOT     throw away whole stacks
  hc scoop X Y Z              fill an empty bucket from that water/lava source (finds a clear line to it)
  hc open X Y Z               right-click a block (table, furnace, chest…) — makes sure the crosshair is on it
  hc place X Y Z [item]      put a block (from the hotbar) into that empty cell
  hc stairs DIR N [a,b]       dig a staircase down N steps toward DIR; stops on liquid/drop/damage/seeing a or b
  hc spiral DIR N [a,b] [grab] spiral staircase straight down (turns right every 2 steps, stays within 3x3)
  hc tunnel DIR N [a,b]       same, flat 1x2 tunnel (branch mining)
  hc upstairs DIR N [a,b]     dig a staircase UP (enclosed way out of a hole)
                              4th arg: ores to mine on the way without stopping, e.g. coal_ore,iron_ore
  hc note TEXT                commentary for the record (and anyone watching): how it's going, what's next
  hc say TEXT                 talk to everyone (public chat)      — other agents only; see AGENTS.md
  hc team TEXT                talk to my team only
  hc tell NAME TEXT           a private message to one player
  hc watch [sec]              keep waiting on the current task; returns when it ends or on alarm
  hc goy Y [a,b]              get to Y level, digging stairs through assumed rock; stop if a/b seen
  hc go X Y Z [a,b]           (optional 4th arg: stop as soon as a block containing a or b is in view)
  hc dig X Y Z                break a block I can see
  hc fight ID [nocrit] [kite] [axe] [stop=6]  melee with jump crits (kite = back off while recharging); stops at low HP
  hc hit ID [swings]          attack a visible entity
  hc use X Y Z                aim at a point and right-click (place / open / interact)
  hc look YAW PITCH | hc lookat X Y Z | hc turn DYAW [DPITCH] | hc around [pitch]
  hc hold KEY... [ticks]      e.g. hc hold forward jump 20
  hc click SLOT [button] [pickup|quick_move|swap]   click a slot of the open screen
  hc eat                      eat the best food in the hotbar
  hc track ID                 keep the crosshair on an entity while it stays in view (hc track = off)
CHEAT MODE only (HONEST_CHEAT=1 ./start.sh — the game is a speedrun, and I know everything the server sends me):
  hc scan [r=160]             one screen: ores, obsidian, lava, chests, spawners, fortress/bastion/portal blocks, mobs, IGT
  hc find BLOCK[,B] [r|all] [n] [ymin ymax]   exact veins, nearest first — loaded chunks live, plus every notable block
                              (ores, obsidian, portals, spawners, chests, fortress bricks, logs, beds, wool, lava…) of every
                              chunk ever loaded; r defaults to all of it (iron_ore matches
                              deepslate_iron_ore; log = every *_log; ~glass = anything containing "glass")
  hc ents [r] [type,type|hostile|item]    every entity the client knows of: exact pos, hp, gear, aggressive, visible
  hc b CMD...                 a Baritone command, run until Baritone is done (mine 3 iron_ore · goto x y z · goto iron_ore ·
                              explore · follow entity cow · farm · tunnel · thisway 200 · surface · stop) — waits; alarms wake it
  hc make ITEM [n]            craft n times: 2x2 grid, else a table in reach (places the one I carry, or makes one)
  hc smelt ITEM [fuel]        smelt the whole stack at a furnace in reach (places the one I carry), just enough fuel
  hc box X1 Y1 Z1 X2 Y2 Z2     every block in a box (≤32 a side), one layer per y, north up — read a structure, plan a build
  hc seek BLOCK[,B] HEADING [dist]  travel that way (north/sw/…) 48 blocks a leg until one of the blocks is loaded
  hc hunt TYPE[,T] [n]        kill n of those animals, nearest first (Baritone to each, fight, pick up the drops)
  hc trash ITEM[,ITEM]        throw those stacks away and walk off (else they're picked right back up)
  hc wear ITEM[,ITEM]         put on armour (what was worn goes back where it came from) / the shield into the off hand
  hc click: screen slots — in the inventory screen the hotbar is 36-44, the bag 9-35, armour 5-8, off hand 45
  hc stash ITEM,ITEM          put those stacks into a chest in reach (dropped items get picked right back up)
  hc b-nowait CMD...          start it and return at once
  hc slot N | hc tohotbar INVSLOT HOTBAR | hc craft ITEM [n] | hc close | hc stop | hc wait TICKS | hc say TEXT | hc respawn
"""
import json, os, sys, urllib.request

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__))); import ports as _ports
# this copy's agent (tools/ports.py); with several agents in one world, HC_AGENT=NAME picks which one I am
API = f"http://127.0.0.1:{_ports.agent_api(os.environ.get('HC_AGENT', 'Agent'))}"
CUR = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "run", ".hc_cursor"); os.makedirs(os.path.dirname(CUR), exist_ok=True)

def get(path):
    with urllib.request.urlopen(API + path, timeout=60) as r: return json.load(r)

def post(obj):
    req = urllib.request.Request(API + "/act", data=json.dumps(obj).encode(), method="POST")
    with urllib.request.urlopen(req, timeout=None) as r: return json.load(r)   # (no limit: with other agents in the world, their thinking can hold mine up)

def cursor():
    try: return int(open(CUR).read())
    except Exception: return 0

def fmt(o):
    if "self" not in o: print(json.dumps(o)); return
    s = o["self"]; out = []
    held = next((i["item"] for i in s.get("inventory", []) if i["slot"] == s["selected_slot"]), "empty hand")
    flags = " ".join(k for k in ("in_water", "on_fire", "dead") if s.get(k))
    if s.get("paused"): out.append(f"⏸  PAUSED — {s['paused']}  (any action resumes)")
    if s.get("FALLING"):
        f = s["FALLING"]
        out.append(f"⚠ FALLING at {f.get('speed_mps', '?')} m/s: dropped {f['dropped_m']} m so far; " + (f"ground ({f['landing_on']}) {f['ground_m']} m below, landing ≈ {f['landing_damage_about']} HP — " if "ground_m" in f else f"{f['ground']} — ") + f["verdict"])
    out.append(f"HP {s['health']}/{s['max_health']}  food {s['food']}  armor {s['armor']}  xp {s['xp_level']}"
               + (f"  air {s['air_bubbles']}" if 'air_bubbles' in s else "") + (f"  [{flags}]" if flags else ""))
    out.append(f"at {s['pos']} facing {s['facing']} (yaw {s['yaw']}, pitch {s['pitch']})  {s['dimension'].split(':')[-1]}/{s['biome']}  "
               f"{s['time']}{'  ⛈ '+s['weather'] if s.get('weather') else ''}  light {s['light']}  holding [{s['selected_slot']}] {held}"
               + (f"  SCREEN: {s['open_screen']}" if 'open_screen' in s else ""))
    if s.get("motion"):
        m = s["motion"]
        out.append("moving" + (f" {m['speed_mps']} m/s {m['heading']}" if 'speed_mps' in m else "") + (f", {'falling' if m['vertical_mps'] < 0 else 'rising'} {abs(m['vertical_mps'])} m/s" if 'vertical_mps' in m else ""))
    inv = ", ".join(f"{i['item']}x{i['count']}@{i['slot']}" + (f"({i['durability_pct']}%)" if 'durability_pct' in i else "") for i in s.get("inventory", []))
    out.append("inventory: " + (inv or "(empty)"))
    if s.get("left_in_crafting_grid"): out.append("⚠ left in the 2x2 crafting grid: " + ", ".join(s["left_in_crafting_grid"]) + "  (hc click SLOT 0 quick_move)")
    if "container" in s:
        ct = s["container"]
        slots = ", ".join(f"[{q['slot']}]{q['item']}" + (f"x{q['count']}" if 'count' in q else "") + (f"(inv{q['your_inv_slot']})" if 'your_inv_slot' in q else "") for q in ct["slots"])
        extra = f"  lit={ct['lit']} flame={ct['flame_pct']}% arrow={ct['arrow_pct']}%" if "lit" in ct else ""
        out.append(f"open {ct['kind']}: {slots}{extra}" + (f"  cursor: {ct['on_cursor']}" if 'on_cursor' in ct else ""))
    c = o["crosshair"]
    out.append("crosshair: " + (f"{c['block']} at {c['pos']} ({c['face']} face)" if "block" in c else
                                 f"entity {c['entity']} ({c['type']})" if "entity" in c else "nothing"))
    ents = o.get("entities", [])
    if "cheat" in o:   # cheat mode: exact truth, one line each
        ch = o["cheat"]
        out.append(f"⏱ {ch['igt']}")
        show = [e for e in ents if e.get("hostile") or e["dist"] < 12][:8]
        out.append(f"entities within 32 m: {len(ents)}" + (" — nearest/hostile:" if show else ""))
        for e in show: out.append("  " + ent_line(e))
        ents = []
    else: out.append(f"I see {len(ents)} creature(s)/thing(s):" if ents else "I see no creatures.")
    for e in ents:
        side = "ahead" if abs(e['bearing']) < 10 else (f"{e['bearing']}° right" if e['bearing'] > 0 else f"{-e['bearing']}° left")
        extra = e.get("looks", {}); gear = e.get("gear", {})
        desc = ", ".join(f"{k}={v}" for k, v in extra.items())
        out.append(f"  #{e['id']} {e['type']}{(' ('+e['item']+')') if 'item' in e else ''} ~{e['dist']}m {side}, elev {e['elevation']}° "
                   f"≈{e['approx_pos']}" + (f"  looks: {desc}" if desc else "") + (f"  gear: {gear}" if gear else "")
                   + ("  moving" + (f" {e['moving']['speed_mps']} m/s {e['moving']['heading']} ({e['moving'].get('relative', '')})" if 'speed_mps' in e['moving'] else "")
                      + (f" {'down' if e['moving']['vertical_mps'] < 0 else 'up'} {abs(e['moving']['vertical_mps'])} m/s" if 'vertical_mps' in e['moving'] else "") if 'moving' in e else "")
                   + (f"  name {e['name']}" + (f" [team {e['team']}{', teammate' if e.get('teammate') else ''}]" if 'team' in e else "") if 'name' in e else "")
                   + ("  (only the name tag shows: behind a wall or in the dark)" if e.get("detail") == "only_name_tag_visible"
                      else "  (too far to make out)" if e.get("detail") else ""))
    for l in o.get("recently_lost_sight_of", []):
        out.append(f"  ↶ lost #{l['id']} {l['type']} {l['lost_s_ago']}s ago: {l['how']}, was ~{l['last_dist']}m"
                   + (f", moving {l['was_moving']}" if 'was_moving' in l else "") + f"; now {l['probably_now']}")
    if o.get("players_online"):
        out.append("players online: " + ", ".join(p["name"] + (f" [{p['team']}]" if "team" in p else "") + (" (me)" if p.get("me") else "")
                                                for p in o["players_online"]))
    bv = [] if "cheat" in o else o.get("blocks_in_view", [])
    if bv:
        out.append("blocks in view (nearest): " + ", ".join(f"{b['block']}@{b['nearest']}~{b['dist']}m" for b in bv[:14])
                   + (f" … +{len(bv)-14} more types" if len(bv) > 14 else ""))
    if "cheat" in o: out.append(f"task: {o['control']['task']}   last: {o['control']['last_result']}")
    else: out.append(f"remembered blocks: {o.get('known_blocks')}   task: {o['control']['task']}   last: {o['control']['last_result']}")
    lines = []
    for ev in o.get("events", []):
        # cheat mode sees every mob anyway: of the sounds keep only the ones that mean danger
        if "cheat" in o and ev["kind"] == "sound" and not any(w in ev.get("subtitle", "") for w in ("hiss", "shoot", "explo", "Arrow", "fuse", "roar", "growl")): continue
        if "cheat" in o and ev["kind"] == "task" and ev.get("text", "").startswith("baritone") and lines and "[baritone]" in lines[-1][0]: pass
        if ev["kind"] == "sound":
            l = f"  🔊 {ev['subtitle']} ({ev.get('loudness','')}, {ev.get('direction','?')})"
        elif ev["kind"] == "chat" and "channel" in ev:
            where = {"public": "", "team": f" [team {ev.get('to','')}]", "private": f" [private → {ev.get('to','')}]"}[ev["channel"]]
            l = f"  🗨 {ev['from']}{where}: {ev['text']}"
        else:
            l = f"  💬 [{ev['kind']}] {ev['text']}"
        if lines and lines[-1][0] == l: lines[-1][1] += 1
        else: lines.append([l, 1])
    # repetitive noise (mining = break/plop over and over): fold runs, and keep only the latest 25 lines
    lines = [l if n == 1 else f"{l} ×{n}" for l, n in lines]
    keep = 8 if "cheat" in o else 25
    if len(lines) > keep: out.append(f"  … {len(lines)-keep} earlier event lines omitted"); lines = lines[-keep:]
    out += lines
    if "cursor" in o: open(CUR, "w").write(str(o["cursor"]))
    print("\n".join(out))

def ent_line(e):
    hp = f" {e['hp']:g}/{e['max_hp']:g}hp" if "hp" in e else ""
    tags = "".join(f" {t}" for t in ("hostile", "aggressive", "baby") if e.get(t)) + ("" if e.get("visible") else " (hidden)")
    item = f" {e['item']}x{e['count']}" if "item" in e else ""
    gear = (" gear " + ",".join(e["gear"].values())) if e.get("gear") else ""
    return f"#{e['id']} {e['type']}{item}{hp} {e['dist']}m @{e['pos']}{tags}{gear}" + (f" name {e['name']}" if "name" in e else "") + (f" ⚠ {e['WARNING']}" if "WARNING" in e else "")

def baritone(cmd, wait=True):
    """a Baritone command; keep the request open (the world runs only while it is) until Baritone is done or an
    alarm wakes me (an alarm pause refuses the next action until I decide: scripts must look at the reply)"""
    r = post({"type": "baritone", "cmd": cmd, "wait": 1200 if wait else 1, "resume": os.environ.get("HC_SCRIPT") != "1", "cursor": cursor()})
    if r.get("result") != "ok": print("->", r.get("result")); return r
    while wait and not r.get("woke"):
        st = get("/status")
        if st["task"] == "idle": break
        r = post({"type": "wait", "wait": 1200, "until_idle": True, "cursor": cursor()})
        if str(r.get("result", "")).startswith("refused"): print("⏸ ", r["result"]); break
        if get("/status")["task"] == "idle": break
    if r.get("woke"): print("⚠️  woke early:", r["woke"])
    o = r.get("observation") or get(f"/observe?cursor={cursor()}")
    fmt(o); return r

def quiet(obj, wait=40):
    """an action whose reply I only need the result of (helpers chaining several steps)"""
    if obj.get("type") not in IN_SCREEN and obj.get("type") not in ("wait", "close_screen", "slot_click", "craft"):
        for _ in range(3):   # (an open screen swallows world actions: a furnace that "couldn't be placed" six times)
            if not clear_screen(): break
    if os.environ.get("HC_SCRIPT") != "1": obj["resume"] = True
    obj.setdefault("wait", wait); obj["cursor"] = cursor()
    return post(obj)

def last_result():
    return get("/status").get("last_result", "")

def make(item, n):
    """craft n times: in the 2x2 grid if it fits, else at a crafting table in reach (placing the one I carry, or making one)"""
    o = get("/observe")
    if o["self"].get("open_screen"): quiet({"type": "close_screen"}, 2)
    r = quiet({"type": "craft", "item": item, "count": n}, 200)
    lr = last_result() if r.get("result") == "crafting" else r.get("result", "")
    if r.get("result") == "crafting" and "made" in lr and "then ran out" not in lr and "missing" not in lr: print(lr); return
    if r.get("result") == "crafting" and "then ran out" in lr: print(lr); return
    tables = get("/find?blocks=crafting_table&r=6&n=3")["clusters"]
    tables = [t for t in tables if t["dist"] <= 4.3]
    if not tables:
        inv = {i["item"]: i for i in get("/observe")["self"]["inventory"]}
        if "crafting_table" not in inv:
            planks = next((k for k in inv if k.endswith("_planks") and inv[k]["count"] >= 4), None)
            log = next((k for k in inv if k.endswith("_log") or k.endswith("_stem")), None)
            if not planks and log:   # (a log makes four)
                quiet({"type": "craft", "item": log.replace("_log", "_planks").replace("_stem", "_planks"), "count": 1}, 100)
                inv = {i["item"]: i for i in get("/observe")["self"]["inventory"]}
                planks = next((k for k in inv if k.endswith("_planks") and inv[k]["count"] >= 4), None)
            if not planks: print("no crafting table, and not 4 planks to make one"); return
            quiet({"type": "craft", "item": "crafting_table", "count": 1}, 100)
        if get("/observe")["self"].get("open_screen"): quiet({"type": "close_screen"}, 4)
        r = quiet({"type": "place", "item": "crafting_table"}, 100)
        print("placing a table:", r.get("result") if r.get("result") != "ok" else last_result())
        for _ in range(20):   # (the block shows up once the server confirms it)
            tables = [t for t in get("/find?blocks=crafting_table&r=6&n=3")["clusters"] if t["dist"] <= 4.6]
            if tables: break
            quiet({"type": "wait"}, 4)
        if not tables: print("couldn't place a crafting table here"); return
    for attempt in (1, 2):
        t = tables[0]["pos"]
        quiet({"type": "interact", "x": t[0], "y": t[1], "z": t[2]}, 60)
        if get("/observe")["self"].get("open_screen"): break
        if attempt == 2: print("couldn't open the table at", t, ":", last_result()); return
        # (in reach by distance but not by sight, say behind a corner: put down a table of my own)
        inv = {i["item"]: i for i in get("/observe")["self"]["inventory"]}
        if "crafting_table" not in inv:
            planks = next((k for k in inv if k.endswith("_planks") and inv[k]["count"] >= 4), None)
            if not planks: print("couldn't open the table at", t, "and no planks for another"); return
            quiet({"type": "craft", "item": "crafting_table", "count": 1}, 100)
        quiet({"type": "place", "item": "crafting_table"}, 100)
        for _ in range(20):
            near = [q for q in get("/find?blocks=crafting_table&r=6&n=3")["clusters"] if q["dist"] <= 4.6 and q["pos"] != t]
            if near: tables = near; break
            quiet({"type": "wait"}, 4)
    r = quiet({"type": "craft", "item": item, "count": n}, 300)
    print(last_result() if r.get("result") == "crafting" else r.get("result"))
    quiet({"type": "close_screen"}, 2)

FUEL_ITEMS = {"coal": 8, "charcoal": 8, "coal_block": 80, "blaze_rod": 12, "lava_bucket": 100}

def smelt(item, fuel=None):
    """smelt the whole stack of ITEM at a furnace in reach (placing the one I carry), with just enough fuel"""
    inv = get("/observe")["self"]["inventory"]
    have = sum(i["count"] for i in inv if i["item"] == item)
    if not have: print("no", item); return
    if fuel is None:
        names = [i["item"] for i in inv]
        fuel = next((f for f in ("coal", "charcoal") if f in names), None) or next((n for n in names if n.endswith("_planks") or n.endswith("_log")), None)
        if not fuel: print("no fuel"); return
    per = FUEL_ITEMS.get(fuel, 1.5)
    need = -(-have // per) if per >= 1 else have
    need = int(max(1, -(-have // per)))
    fs = [f for f in get("/find?blocks=furnace&r=6&n=3")["clusters"] if f["dist"] <= 4.3]
    if not fs and not any(i["item"] == "furnace" for i in get("/observe")["self"]["inventory"]):
        make("furnace", 1)   # (8 cobblestone, at a table)
    if not fs:
        if get("/observe")["self"].get("open_screen"): quiet({"type": "close_screen"}, 4)
        r = quiet({"type": "place", "item": "furnace"}, 100); print("placing a furnace:", r.get("result") if r.get("result") != "ok" else last_result())
        for _ in range(5):
            fs = [f for f in get("/find?blocks=furnace&r=6&n=3")["clusters"] if f["dist"] <= 4.6]
            if fs: break
            quiet({"type": "wait"}, 4)
        if not fs: print("couldn't place a furnace"); return
    f = fs[0]["pos"]
    quiet({"type": "interact", "x": f[0], "y": f[1], "z": f[2]}, 60)
    c = get("/observe")["self"].get("container") or {}
    if not c.get("slots"): print("couldn't open the furnace:", last_result()); return
    click = lambda sl, b=0, m="pickup": quiet({"type": "slot_click", "slot": sl, "button": b, "mode": m}, 3)
    stacks = lambda name: [q["slot"] for q in (get("/observe")["self"].get("container") or {}).get("slots", []) if q.get("item") == name and q["slot"] > 2]
    for sl in stacks(item): click(sl); click(0); click(sl)   # (put back what didn't fit)
    fsl = stacks(fuel)
    if fsl:
        click(fsl[0])
        for _ in range(need): click(1, 1)
        click(fsl[0])
    print(f"smelting {have} {item} with {need} {fuel}…")
    import time
    for _ in range(60):
        r = quiet({"type": "wait", "wait": 200}, 200)
        c = get("/observe")["self"].get("container") or {}
        inp = [q for q in c.get("slots", []) if q["slot"] == 0 and q.get("item") not in (None, "empty")]
        if not inp or r.get("woke"): break
    if r.get("woke"): print("⚠️  woke early:", r["woke"])
    click(2, 0, "quick_move")
    quiet({"type": "close_screen"}, 2)
    print("now:", ", ".join(f"{i['item']}x{i['count']}" for i in get("/observe")["self"]["inventory"]))

def stash(items):
    """put these items into a chest in reach (thrown items are just picked up again)"""
    cs = [c for c in get("/find?blocks=chest,barrel&r=6&n=3")["clusters"] if c["dist"] <= 4.3]
    if not cs: print("no chest in reach"); return
    p = cs[0]["pos"]; quiet({"type": "interact", "x": p[0], "y": p[1], "z": p[2]}, 60)
    c = get("/observe")["self"].get("container") or {}
    if not c.get("slots"): print("couldn't open it:", last_result()); return
    n = 0
    for q in c["slots"]:
        if "your_inv_slot" in q and q.get("item") in items:
            quiet({"type": "slot_click", "slot": q["slot"], "button": 0, "mode": "quick_move"}, 2); n += 1
    quiet({"type": "close_screen"}, 2)
    print(f"stashed {n} stacks at {p}")

def seek(blocks, heading, dist, step=48):
    """travel in a straight line (Baritone, a leg of STEP blocks at a time) until one of BLOCKS shows up in the loaded
    chunks; heading = north/south/east/west/ne/nw/se/sw. Stops on an alarm or a stuck leg."""
    import math
    dirs = {"north": (0, -1), "south": (0, 1), "east": (1, 0), "west": (-1, 0), "ne": (1, -1), "nw": (-1, -1), "se": (1, 1), "sw": (-1, 1)}
    dx, dz = dirs[heading]; norm = math.hypot(dx, dz); dx, dz = dx / norm, dz / norm
    p0 = get("/observe")["self"]["pos"]
    for k in range(1, int(dist // step) + 2):
        hit = get(f"/find?blocks={','.join(blocks)}&r=200&n=3")
        if hit.get("clusters"):
            for cl in hit["clusters"]: print(f"  FOUND {cl['block']} ×{cl['count']} at {cl['pos']}  {cl['dist']} m")
            return True
        gx, gz = round(p0[0] + dx * step * k), round(p0[2] + dz * step * k)
        r = post({"type": "go", "x": gx, "z": gz, "wait": 1200, "resume": os.environ.get("HC_SCRIPT") != "1", "cursor": cursor()})
        while not r.get("woke") and get("/status")["task"] != "idle":
            r = post({"type": "wait", "wait": 1200, "until_idle": True, "cursor": cursor()})
        lr = last_result(); s = get("/observe")["self"]
        print(f"leg {k}: -> ({gx}, {gz}): {lr.split('-> ')[-1]}   now at {s['pos']}, HP {s['health']}")
        if r.get("woke"): print("⚠️  woke early:", r["woke"]); return False
        if "arrived" not in lr and math.hypot(s["pos"][0] - gx, s["pos"][2] - gz) > step * 0.6: print("stuck: stopping"); return False
    print("not found within", dist); return False

def hunt(types, n):
    """kill n animals of these types (nearest first): Baritone to it, fight, pick up the drops"""
    import urllib.parse
    for k in range(n):
        es = get(f"/ents?r=200&type={urllib.parse.quote(types)}&n=5")["entities"]
        es = [e for e in es if not e.get("baby") and e.get("hp", 1) > 0]
        if not es: print("no more", types); break
        e = es[0]; print(f"→ #{e['id']} {e['type']} {e['dist']} m")
        if e["dist"] > 3:
            r = post({"type": "baritone", "cmd": f"follow entity {e['type']}" if False else f"goto {int(e['pos'][0])} {int(e['pos'][1])} {int(e['pos'][2])}", "wait": 1200, "resume": True, "cursor": cursor()})
            while not r.get("woke") and get("/status")["task"] != "idle":
                r = post({"type": "wait", "wait": 1200, "until_idle": True, "cursor": cursor()})
            if r.get("woke") and "message" not in r["woke"]: print("⚠️  woke early:", r["woke"]); return
        r = post({"type": "fight", "id": e["id"], "crit": False, "stop_hp": 8, "wait": 600, "resume": True, "cursor": cursor()})
        while get("/status")["task"].startswith("fight") and get("/observe")["self"]["health"] >= 8:
            r = post({"type": "wait", "wait": 100, "until_idle": True, "cursor": cursor()})
        print("  ", last_result().split("-> ")[-1])
        import math, time
        last = next((q for q in get(f"/ents?r=40&type={e['type']}&n=40")["entities"] if q["id"] == e["id"]), None)
        at = last["pos"] if last else get("/observe")["self"]["pos"]
        quiet({"type": "wait"}, 10)   # (the drops pop out a moment after it dies)
        drops = [d for d in get("/ents?r=48&type=item&n=40")["entities"] if math.dist(d["pos"], at) < 6 or d["dist"] < 5]
        for d in drops:
            r = post({"type": "baritone", "cmd": f"goto {int(d['pos'][0])} {int(round(d['pos'][1]))} {int(d['pos'][2])}", "wait": 200, "resume": True, "cursor": cursor()})
    fmt(get(f"/observe?cursor={cursor()}"))

ARMOR_SLOT = {"helmet": 5, "chestplate": 6, "leggings": 7, "boots": 8}

def trash(items):
    """throw these stacks away and walk off from them (standing on dropped things just picks them back up)"""
    o = get("/observe")["self"]; inv = o["inventory"]
    slots = [i["slot"] for i in inv if i["item"] in items]
    if not slots: print("nothing to throw"); return
    n = sum(i["count"] for i in inv if i["item"] in items)
    quiet({"type": "drop", "slots": slots}, 8 + 2 * n)
    import math
    yaw = math.radians(o["yaw"]); p = o["pos"]
    bx, bz = round(p[0] + 7 * math.sin(yaw)), round(p[2] - 7 * math.cos(yaw))   # (7 blocks behind where I face)
    quiet({"type": "go", "x": bx, "z": bz}, 200)
    print(f"threw {n} items; now at", get("/observe")["self"]["pos"])

def menu_slot(inv_slot):
    """inventory slot (as obs lists them: 0-8 hotbar, 9-35 bag) -> slot of the inventory screen (hotbar is 36-44 there)"""
    return inv_slot + 36 if inv_slot < 9 else inv_slot

def wear(item):
    """put on this armour piece (or the shield, into the off hand); what was worn goes where it came from"""
    inv = get("/observe")["self"]["inventory"]
    it = next((i for i in inv if i["item"] == item), None)
    if not it: print("no", item); return
    if item == "shield": quiet({"type": "to_hotbar", "slot": it["slot"], "hotbar": 40}, 4) if it["slot"] >= 9 else (quiet({"type": "slot_click", "slot": menu_slot(it["slot"])}, 3), quiet({"type": "slot_click", "slot": 45}, 3), quiet({"type": "slot_click", "slot": menu_slot(it["slot"])}, 3)); print("off hand:", get("/observe")["self"].get("equipment", {}).get("offhand")); return
    kind = next((k for k in ARMOR_SLOT if item.endswith(k)), None)
    if not kind: print(item, "is not armour"); return
    ms = menu_slot(it["slot"])
    for sl in (ms, ARMOR_SLOT[kind], ms): quiet({"type": "slot_click", "slot": sl, "mode": "pickup"}, 3)
    print("wearing:", get("/observe")["self"].get("equipment"))

NOTE_NAG = 12   # actions without a word of commentary before hc reminds you

def nudge(kind):
    """count actions since the last `hc note`; after NOTE_NAG of them, ask for a line of commentary"""
    if os.environ.get("HC_SCRIPT") == "1": return
    f = os.path.join(os.path.dirname(CUR), ".hc_since_note")
    n = 0 if kind == "note" else (int(open(f).read() or 0) if os.path.exists(f) else 0) + 1
    open(f, "w").write(str(n))
    if n and n % NOTE_NAG == 0:
        print(f"📝 {n} actions since your last note — one line please: hc note \"how it's going, what's next\"")

# Actions that happen inside a screen; everything else happens in the world, and a screen left open
# silently swallows it (the dig just times out — that cost this agent most of a morning three times).
IN_SCREEN = {"craft", "open", "close", "interact", "use_at", "inventory", "slot", "to_hotbar",
             "hotbar", "say", "note", "respawn", "stop", "pause"}

def clear_screen():
    """A human presses Escape before digging. Do the same, and say so out loud."""
    try:
        s = get("/observe").get("self", {})
        if s.get("open_screen"):
            print(f"ℹ️  {s['open_screen']} was open — closing it (an open screen swallows every world action)")
            post({"type": "close_screen", "cursor": cursor(), "resume": True, "wait": 10})
            return True
    except Exception:
        pass
    return False

def act(obj, wait=400):
    if obj.get("type") not in IN_SCREEN: clear_screen()
    obj.setdefault("wait", wait); obj["cursor"] = cursor()
    nudge(obj.get("type"))
    # me typing a command = a decision, so it resumes a paused game; scripts set HC_SCRIPT=1 and get refused instead
    if os.environ.get("HC_SCRIPT") != "1": obj["resume"] = True
    if os.environ.get("HC_FRAME") == "1":   # frame-by-frame play: queue the input, keep the world frozen, `hc step N` runs it
        obj.pop("resume", None); obj["keep_paused"] = True; obj["wait"] = 0
    r = post(obj)
    if r.get("result") not in ("ok",): print("->", r.get("result"))
    if r.get("woke"): print("⚠️  woke early:", r["woke"])
    if "observation" in r: fmt(r["observation"])

def speed_auto(run):
    """Try 2x, 3x, 4x ... with the world running (I just stand and wait ~5 s of game time at each), time it, and
    settle on the fastest speed this machine really keeps up with (>= 95%)."""
    import time
    def timed(n):   # wall seconds for 100*n game ticks at n x (5 s of game time), minus the fixed cost of an action
        run([f"tick rate {20 * n}"]); t0 = time.time()
        post({"type": "wait", "wait": 100 * n, "resume": True})
        return time.time() - t0
    overhead = max(0.0, timed(1) - 5.0)
    best = 1
    for n in (2, 3, 4, 5, 6, 8, 10):
        got = 100 * n / max(0.01, timed(n) - overhead)
        ok = got >= 0.95 * 20 * n
        print(f"  {n}x: wanted {20 * n} ticks/s, got {got:.0f} — {'ok' if ok else 'too fast for this machine'}")
        if not ok: break
        best = n
    run([f"tick rate {20 * best}"])
    print(f"speed set to {best}x (if the machine ever falls behind, the game drops back to 1x by itself)")

