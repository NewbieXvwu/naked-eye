index 0000000..eeed9e5
--- /dev/null
+++ b/src/api/java/baritone/api/utils/HonestWorld.java
@@ -0,0 +1,45 @@
+/*
+ * This file is part of Baritone (honest fork).
+ *
+ * Baritone is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+package baritone.api.utils;
+
+import net.minecraft.util.Mth;
+import net.minecraft.world.level.block.state.BlockState;
+
+/**
+ * Honest-perception hook. When {@link #lookup} is set, every block Baritone plans or executes with
+ * comes from the agent's memory of what it has SEEN, not from the client's chunk data.
+ * Unknown blocks are reported as {@code null}, which Baritone treats as air: you may pass through
+ * space you haven't seen, but you can never stand on ground you haven't seen.
+ */
+public final class HonestWorld {
+    private HonestWorld() {}
+
+    public interface Lookup {
+        /** @return the remembered state, or null if never seen */
+        BlockState get(int x, int y, int z);
+    }
+
+    public static volatile Lookup lookup;
+
+    /** Max camera turn per tick in degrees; 0 = unlimited (vanilla Baritone behaviour). */
+    public static volatile float maxTurnPerTick = 0f;
+
+    public static float clampYaw(float from, float to) {
+        float m = maxTurnPerTick;
+        if (m <= 0) return to;
+        return from + Mth.clamp(Mth.wrapDegrees(to - from), -m, m);
+    }
+
+    public static float clampPitch(float from, float to) {
+        float m = maxTurnPerTick;
+        if (m <= 0) return to;
+        return Mth.clamp(from + Mth.clamp(to - from, -m, m), -90f, 90f);
+    }
+}
