     public final Setting<Boolean> useSwordToMine = new Setting<>(true);
 
+    /**
+     * Honest fork: among hotbar tools that actually speed up mining this block (and get its drops),
+     * pick the one made of the cheapest material, not the fastest. Saves the iron pickaxe for ore.
+     */
+    public final Setting<Boolean> preferCheapestAdequateTool = new Setting<>(false);
+
     /**
      * Desktop notifications
      */
diff --git a/src/main/java/baritone/utils/ToolSet.java b/src/main/java/baritone/utils/ToolSet.java
