@@ -144,6 +144,11 @@ public class ToolSet {
             return player.getInventory().getSelectedSlot();
         }
 
+        if (Baritone.settings().preferCheapestAdequateTool.value) {
+            int cheap = cheapestAdequateSlot(b.defaultBlockState());
+            if (cheap >= 0) return cheap;
+        }
+
         int best = 0;
         double highestSpeed = Double.NEGATIVE_INFINITY;
         int lowestCost = Integer.MIN_VALUE;
@@ -179,6 +184,26 @@ public class ToolSet {
         return best;
     }
 
+    /** Honest fork: cheapest-material hotbar tool that is effective on (and harvests) this block; -1 if none. */
+    private int cheapestAdequateSlot(BlockState state) {
+        int best = -1, bestCost = Integer.MAX_VALUE;
+        double bestSpeed = -1;
+        for (int i = 0; i < 9; i++) {
+            ItemStack st = player.getInventory().getItem(i);
+            if (st.isEmpty() || st.getDestroySpeed(state) <= 1f) continue;
+            if (state.requiresCorrectToolForDrops() && !st.isCorrectToolForDrops(state)) continue;
+            if (Baritone.settings().itemSaver.value && st.getMaxDamage() > 1
+                    && st.getDamageValue() + Baritone.settings().itemSaverThreshold.value >= st.getMaxDamage()) continue;
+            // NB: getMaterialCost() tests the *tool* against repair-material tags (cobblestone, iron_ingot...),
+            // which a pickaxe never matches, so it is -1 for everything. Max durability ranks tiers correctly
+            // (wood 59 < stone 131 < iron 250 < diamond 1561 < netherite 2031; gold 32 is cheap anyway).
+            int cost = st.getMaxDamage() > 0 ? st.getMaxDamage() : Integer.MAX_VALUE - 1;
+            double sp = calculateSpeedVsBlock(st, state);
+            if (cost < bestCost || (cost == bestCost && sp > bestSpeed)) { best = i; bestCost = cost; bestSpeed = sp; }
+        }
+        return best;
+    }
+
     /**
      * Calculate how effectively a block can be destroyed
      *
